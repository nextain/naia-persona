# Dependencies
node_modules/

# Build
dist/
.next/
*.tsbuildinfo

# Environment & Secrets (T4)
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx
*.key

# Auth secrets (AES-256-GCM encrypted at rest, naia-os #337)
# Format: <ADK_ROOT>/naia-settings/auth/{dev,prod}.json.enc
# Master password lives in OS keychain, not in this repo.
naia-settings/auth/*.enc

# Local machine config (per-machine paths, local gateway URL, test persona)
naia-settings/config.json

# Chat session transcripts — personal conversation data, never shared
naia-settings/.sessions/

# Discord AI session bindings, persona, and operator IDs are local/private.
naia-settings/messenger-sessions/config.json

# Local runtime state and credentials (never commit)
/conversations/
/naia-settings/.keys/
/naia-settings/credentials
/naia-settings/processing.json
/naia-settings/slots-manifest.json
/naia-settings/ui-config.json

# Per-machine LLM routing (points at whatever pod this machine happens to run)
.agents/context/llm-config.yaml

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Cache
.ruff_cache/
.mypy_cache/
.pytest_cache/

# ctx index (auto-rebuilt by hook, never committed)
.agents/context/.ctx-index.json

# Deterministic local hook queues and scratch receipts
.agents/work/

