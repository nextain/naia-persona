# Naia ADK — environment variables (example)
# This file documents variable names only. NEVER commit real keys.
#   .env.local            → development gateway/credentials
#   .env.production.local → production gateway/credentials (prod-gateway-guard
#                           blocks prod credentials from landing in .env.local)

# ── LLM gateway (any-llm) ────────────────────────────────────────────────────
# User-scoped Naia account key from https://naia.nextain.io (recommended).
# This is not a gateway master key. The default endpoint is api.nextain.io/v1.
# Set this in the process environment or an OS credential manager. Do not copy
# a user-scoped production key into `.env.local`.
NAIA_KEY=
# Optional model/base overrides. Live choices: GET https://api.nextain.io/v1/models
NAIA_MODEL=deepseek-v4-flash
NAIA_BASE_URL=https://api.nextain.io

# Base URL of your any-llm gateway. Consumed by packages/naia-anyllm and the
# dashboard. Example: https://your-gateway.example.com
GATEWAY_URL=
# Dev gateway base URL (used in .env.local during development).
DEV_GATEWAY_URL=
# Master key for the gateway (server-side only, never expose to the browser).
GATEWAY_MASTER_KEY=

# ── Direct LLM providers (optional — only if not routing through the gateway) ─
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ── Dashboard (Next.js) ──────────────────────────────────────────────────────
# Public API base URL exposed to the browser (must start with NEXT_PUBLIC_).
NEXT_PUBLIC_API_URL=

# ── Harness / guard overrides (advanced, optional) ───────────────────────────
# Override the prod-gateway-guard detection for your own fork. The guard never
# stores the literal prod key — it matches the SHA-256 digest of your key.
#   PROD_MASTER_KEY_SHA256 = hex sha256 of your prod gateway master key
#   PROD_GATEWAY_HOST_FRAGMENT = host prefix that identifies your prod gateway
PROD_MASTER_KEY_SHA256=
PROD_GATEWAY_HOST_FRAGMENT=
# Signing key for the behavioral-ledger harness (per-machine; auto-generated).
BEH_SIGN_KEY=
# Override the ADK workspace root used by the pi-runtime E2E harness.
NAIA_ADK_ROOT=
